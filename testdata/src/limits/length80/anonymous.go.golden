package length80

// --- Anonymous Functions & Identifiers ---

// BlankShort проверяет пустые идентификаторы.
func BlankShort(_ int, _ string) {} // want "Multi-line signature can be collapsed to one line"

// MethodWithBlanksInterface проверяет пустые идентификаторы в интерфейсе.
type MethodWithBlanksInterface interface {
	MethodWithBlanks(_ int, _ string, _ bool, _ float64) // want "Multi-line signature can be collapsed to one line"
}

// OuterFunction проверяет вложенные анонимные функции.
func OuterFunction() {
	// Анонимная функция внутри.
	callback := func(a int, b int) int { // want "Multi-line signature can be collapsed to one line"
		return a + b
	}
	_ = callback
}
