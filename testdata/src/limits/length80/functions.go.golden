package length80

import "context"

// Regular function split across lines.
// Should be collapsed since length < 120.
func ShortFunction(a int) error { // want "Signature can be formatted more compactly"
	return nil
}

// Function already on one line.
// Linter should ignore.
func AlreadyOneLine(a int, b int) {}

// Very long function.
// Should remain split across lines.
func VeryLongFunctionThatShouldNotBeCollapsed(
	paramOneWithVeryLongName string,
	paramTwoWithVeryLongName string,
	paramThreeWithVeryLongName string,
	paramFourWithVeryLongName string,
	paramFiveWithVeryLongName string,
) {
}

// Function with multiple return values.
func MultipleReturns(x int, y int) (int, error) { // want "Signature can be formatted more compactly"
	return x + y, nil
}

// Function with named return values.
func NamedReturns(a int, b int) (sum int, err error) { // want "Signature can be formatted more compactly"
	return a + b, nil
}

// Function with variadic parameters.
func Sum(nums ...int) int { // want "Signature can be formatted more compactly"
	total := 0
	for _, n := range nums {
		total += n
	}
	return total
}

// Function without parameters.
func NoParams() error {
	return nil
}

// Function without return values.
func NoReturn(msg string) { // want "Signature can be formatted more compactly"
	println(msg)
}

// Function with mixed parameters.
func MixedParams(a, b int, c string) error { // want "Signature can be formatted more compactly"
	return nil
}

// Boundary case - exactly 120 characters.
func ExactlyAtLimit(aaaaaa int, bbbbbb int, cccccc int, dddddd int, eeeeee int,
	ffffff int, gggggg int) int { // want "Signature can be formatted more compactly"
	return 0
}

// Generics.
// Should be collapsed correctly: func Generic[T any](val T)
func Generic[T any](val T) { // want "Signature can be formatted more compactly"
}

// Complex generics with multiple type parameters.
func Map[T any, R any](items []T, fn func(T) R) []R { // want "Signature can be formatted more compactly"
	result := make([]R, len(items))
	for i, item := range items {
		result[i] = fn(item)
	}
	return result
}

// Function already on one line with generics (should not be changed).
func AlreadyOneLineGeneric[T any](val T) T { return val }

// Methods with receiver.
type Calculator struct{}

func (c *Calculator) Add(a int, b int) int { // want "Signature can be formatted more compactly"
	return a + b
}

func (c *Calculator) Multiply(x int, y int) int {
	return x * y
}

// Anonymous function (Closure).
// Variable assignment.
var myFunc = func(a int, b int) int { // want "Signature can be formatted more compactly"
	return a + b
}

var anotherFunc = func(ctx context.Context) error {
	return nil
}
