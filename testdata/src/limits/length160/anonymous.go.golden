package length160

// --- Anonymous Functions & Identifiers ---

// BlankShort checks blank identifiers.
func BlankShort(_ int, _ string) { // want "Signature can be formatted more compactly"
}

// MethodWithBlanksInterface checks blank identifiers in interface.
type MethodWithBlanksInterface interface {
	MethodWithBlanks(_ int, _ string, _ bool, _ float64) // want "Signature can be formatted more compactly"
}

// OuterFunction checks nested anonymous functions.
func OuterFunction() {
	// Anonymous function inside.
	callback := func(a int, b int) int { // want "Signature can be formatted more compactly"
		return a + b
	}
	_ = callback
}
