package length160

import "context"

// Simple struct with a func field that should be collapsed.
type Handler struct {
	Process func(ctx context.Context) error // want "Multi-line signature can be collapsed to one line"
}

// Struct with multiple func fields.
type MultiHandler struct {
	// Short field - should be collapsed
	OnStart func(id string) error // want "Multi-line signature can be collapsed to one line"

	// Field already on one line
	OnStop func() error

	// Long field - should remain split
	OnProcessWithVeryLongNameAndManyParameters func(parameterOne string, parameterTwo string, parameterThree string, parameterFour string) error // want "Multi-line signature can be collapsed to one line"

	// Field with multiple return values - should be collapsed
	GetData func(key string) (string, error) // want "Multi-line signature can be collapsed to one line"
}

// Struct with func fields with generics.
type GenericHandler[T any] struct {
	Process func(item T) error // want "Multi-line signature can be collapsed to one line"

	Transform func(item T) T
}

// Struct with regular fields and func fields.
type MixedStruct struct {
	Name string
	Age  int

	Validate func(value string) bool // want "Multi-line signature can be collapsed to one line"

	Transform func(input string) string
}

// Struct with variadic parameters in func field.
type VariadicHandler struct {
	Process func(items ...string) error // want "Multi-line signature can be collapsed to one line"
}

// Struct with func field having named return values.
type NamedReturnsHandler struct {
	Process func(id string) (result string, err error) // want "Multi-line signature can be collapsed to one line"
}

// Struct with func field with mixed parameters.
type MixedParamsHandler struct {
	Process func(a, b int, c string) error // want "Multi-line signature can be collapsed to one line"
}

// Complex case: struct declared inside a function,
// and inside the struct a field with multi-line function.
func ComplexCase() {
	type LocalStruct struct {
		// This field should be collapsed
		Handler func(ctx context.Context, id string) error // want "Multi-line signature can be collapsed to one line"

		// This field is already on one line
		Simple func() error

		// This long field should remain split
		VeryLongHandler func(parameterWithVeryLongName string, anotherParameterWithVeryLongName string, yetAnotherParameterWithVeryLongName string) error // want "Multi-line signature can be collapsed to one line"
	}
	_ = LocalStruct{}
}

// Another complex case: nested structs.
func NestedStructCase() {
	type Outer struct {
		Inner struct {
			// Field in nested struct (anonymous struct not supported by linter)
			Process func(
				data string,
			) error
		}

		// Field in main struct - should be collapsed
		Transform func(input string) string // want "Multi-line signature can be collapsed to one line"
	}

	_ = Outer{}
}

// Anonymous struct in variable with func field.
// (anonymous structs not supported by linter)
var anonymousStruct = struct {
	Handler func(
		id string,
	) error

	Simple func() error
}{
	Handler: func(id string) error { return nil },
	Simple:  func() error { return nil },
}

// Struct with func field returning a function.
type HigherOrderHandler struct {
	GetHandler func(config string) func(string) error // want "Multi-line signature can be collapsed to one line"
}

// Struct with func field taking a function as parameter.
type CallbackHandler struct {
	Process func(callback func(string) error) error // want "Multi-line signature can be collapsed to one line"

	ProcessMultiple func(callback func(string) error, fallback func() error) error
}
